{
  "meta": {
    "title": "TransitMatters Swift"
  },
  "theme": {
    "color": {
      "documentation-intro-fill": "#1773ba",
      "documentation-intro-accent": "#4b95cf",
      "documentation-intro-figure": "#fff",
      "documentation-intro-title": "currentcolor",
      "documentation-intro-eyebrow": "color-mix(in srgb, currentcolor 70%, transparent)",
      "link": { "light": "#1773ba", "dark": "#6cb4ea" },
      "figure-blue": { "light": "#1773ba", "dark": "#4b95cf" },
      "fill-blue": "#1773ba",
      "focus-color": "rgba(23, 115, 186, 0.6)",
      "code-line-highlight": "rgba(23, 115, 186, 0.08)",
      "navigator-item-hover": { "light": "rgba(23, 115, 186, 0.05)", "dark": "rgba(75, 149, 207, 0.25)" },
      "nav-link-color-hover": "#f17a21",
      "nav-dark-link-color-hover": "#f17a21",
      "figure-gray": { "light": "#212121", "dark": "#c4c7d6" },
      "fill": { "light": "#fff", "dark": "#1e2029" },
      "fill-secondary": { "light": "#f7f7f7", "dark": "#272935" },
      "fill-tertiary": { "light": "#f0f0f0", "dark": "#2d3043" },
      "fill-gray-secondary": { "light": "#f5f5f5", "dark": "#232430" },
      "fill-gray-tertiary": { "light": "#f0f0f0", "dark": "#393c4c" },
      "fill-gray-quaternary": { "light": "#f0f0f0", "dark": "#393c4c" },
      "nav-dark-solid-background": "#1e2029",
      "nav-dark-expanded": "#272935",
      "nav-dark-stuck": "rgba(30, 32, 41, 0.9)",
      "nav-dark-uiblur-stuck": "rgba(30, 32, 41, 0.7)",
      "nav-dark-uiblur-expanded": "rgba(30, 32, 41, 0.9)"
    },
    "typography": {
      "html-font": "Roboto, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "html-font-mono": "\"Roboto Mono\", SFMono-Regular, Menlo, Consolas, monospace"
    }
  }
}
